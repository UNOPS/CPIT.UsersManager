{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Port=5432;Database=UsersManagerSample;User Id=postgres;Password=postgres;"
  },
  "DatabaseProvider": "PostgreSQL",
  "JwtSettings": {
    "securityKey": "YourSuperSecretKeyThatIsAtLeast32CharactersLong!",
    "validIssuer": "SampleApp",
    "validAudience": "SampleApp",
    "expiryInMinutes": 60
  },
  "GoogleAuthSettings": {
    "clientId": "your-google-client-id-here"
  }
}